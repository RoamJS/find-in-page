{
  "name": "find-in-page",
  "version": "1.0.0",
  "description": "Find text across the current page, including folded blocks. Preview highlighted matches, jump into editing, and navigate with keyboard shortcuts.",
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "start": "samepage dev",
    "prebuild:roam": "npm install",
    "build:roam": "samepage build --dry",
    "test": "samepage test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "roam",
    "roam-research",
    "roamjs"
  ],
  "license": "MIT",
  "dependencies": {
    "roamjs-components": "^0.86.4"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.11"
  },
  "samepage": {
    "extends": "node_modules/roamjs-components/package.json"
  }
}
